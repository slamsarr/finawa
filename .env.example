# PostgreSQL
POSTGRES_DB=test
POSTGRES_USER=test
POSTGRES_PASSWORD=test


# Backend
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080
FILE_STORAGE_ROOT=/app/upload

JWT_ACCESS_TOKEN_VALIDITY=900000 # 15 min
JWT_REFRESH_TOKEN_VALIDITY=86400000 # 1 day
JWT_REFRESH_TOKEN_VALIDITY_REMEMBER=604800000 # 7 days
JWT_BASE64_SECRET=mysecret

MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_AUTH=false
MAIL_STARTTLS=false

MAIL_FROM=noreply@gmail.com
MAIL_VERIFICATION_URL=
MAIL_TOKEN_VALIDITY=86400 # 1 day

CORS_ALLOWED_ORIGINS=http://localhost:4200


# Frontend
FRONTEND_PORT=4200
